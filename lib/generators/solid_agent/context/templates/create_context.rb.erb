# frozen_string_literal: true

class Create<%= class_name.pluralize %> < ActiveRecord::Migration<%= migration_version %>
  def change
    create_table :<%= table_name %> do |t|
      # Polymorphic association to any model (User, Document, Project, etc.)
      t.references :contextable, polymorphic: true, index: true

      # Agent identification
      t.string :agent_name, null: false
      t.string :action_name, null: false

      # System instructions for the conversation
      t.text :instructions

      # Flexible options storage (input_params, model settings, etc.)
      t.column :options, json_type, **json_default({})

      # Tracing/debugging
      t.string :trace_id, index: true

      # Token usage tracking
      t.integer :total_input_tokens, default: 0
      t.integer :total_output_tokens, default: 0

      t.timestamps
    end

    add_index :<%= table_name %>, [:agent_name, :action_name]
    add_index :<%= table_name %>, :created_at
  end

  private

  # jsonb on PostgreSQL, json elsewhere: SQLite and MySQL have no jsonb type,
  # and SQLite aborts the migration on it.
  def json_type
    @json_type ||= postgres? ? :jsonb : :json
  end

  # MySQL rejects a default on a JSON column outright ("BLOB, TEXT, GEOMETRY or
  # JSON column can't have a default value"), which aborts the migration, so
  # the column is created without one there. The gem assigns every JSON column
  # it writes and reads them nil-safely, so a NULL reads as the empty default
  # would.
  def json_default(value)
    mysql? ? {} : { default: value }
  end

  def postgres?
    adapter_name.include?("postgres")
  end

  def mysql?
    adapter_name.include?("mysql") || adapter_name.include?("trilogy")
  end

  def adapter_name
    connection.adapter_name.to_s.downcase
  end
end
