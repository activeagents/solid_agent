# frozen_string_literal: true

class Create<%= message_class_name.pluralize %> < ActiveRecord::Migration<%= migration_version %>
  def change
    create_table :<%= message_table_name %> do |t|
      t.references :<%= file_name %>, null: false, foreign_key: true, index: true

      # Message role: user, assistant, system, tool
      t.string :role, null: false

      # Message content
      t.text :content

      # For tool calls and results
      t.string :tool_call_id
      t.string :tool_name
      t.column :tool_arguments, json_type, **json_default({})
      t.column :tool_result, json_type

      # For multimodal content
      t.column :attachments, json_type, **json_default([])

      # Metadata
      t.column :metadata, json_type, **json_default({})

      # Provenance snapshot + content checksum (populated by HasContext)
      t.column :provenance, json_type, **json_default({})
      t.string :content_checksum

      t.timestamps
    end

    add_index :<%= message_table_name %>, :role
    add_index :<%= message_table_name %>, :tool_call_id
    add_index :<%= message_table_name %>, [:<%= file_name %>_id, :created_at]
  end

  private

  # jsonb on PostgreSQL, json elsewhere: SQLite and MySQL have no jsonb type,
  # and SQLite aborts the migration on it.
  def json_type
    @json_type ||= postgres? ? :jsonb : :json
  end

  # MySQL rejects a default on a JSON column outright ("BLOB, TEXT, GEOMETRY or
  # JSON column can't have a default value"), which aborts the migration, so
  # the column is created without one there. The gem assigns every JSON column
  # it writes and reads them nil-safely, so a NULL reads as the empty default
  # would.
  def json_default(value)
    mysql? ? {} : { default: value }
  end

  def postgres?
    adapter_name.include?("postgres")
  end

  def mysql?
    adapter_name.include?("mysql") || adapter_name.include?("trilogy")
  end

  def adapter_name
    connection.adapter_name.to_s.downcase
  end
end
